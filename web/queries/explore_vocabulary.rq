# What vocabulary does each endpoint DECLARE and what does it USE?
#
# The explorer's whole axis. Every one of its four states is a pair of answers:
# a term declared and observed is `verified`, observed but not declared is
# `undeclared-but-verified`, declared but not observed is `declared-only`, and a
# term in neither is not in the payload at all.
#
# ONE RUN SUPPLIES BOTH HALVES, and that is the load-bearing decision here. The
# run that measured an endpoint most recently and the run that profiled its
# content are routinely different, because a profile pass is expensive and
# declined at the default cost ceiling. Taking `declaredClass` from the newest
# measuring run and `profiledClass` from an older profiling one would compare a
# description read on Tuesday against content read the week before, and publish
# the difference as though one sweep had found it. So both are read from the
# run the sample pointer names: the newest sweep that actually looked at this
# endpoint's content.
#
# The consequence, stated because it is a real limitation rather than an
# oversight: an endpoint whose description changed since its last content sweep
# is described here as it was at that sweep. The endpoint page reports the
# newer reading, and the two disagreeing is the store being honest about two
# different observations rather than a defect.
#
# ?endpoint is NOT substituted. This query answers for every endpoint at once,
# because the explorer's payload is built in one pass over the store rather
# than per endpoint: a facet count that says "12 endpoints use foaf:name"
# cannot be computed one endpoint at a time.
#
# `declared` is a plain boolean rather than two shapes, so a term declared and
# used produces one row per role and the caller unions them. A term that is
# declared and never used still yields a row, which is the `declared-only`
# state and the one an absent row would silently erase.

PREFIX sw: <urn:sparqlwatch:>

# FOUR FLAT ARMS, EACH REPEATING THE POINTER, and the repetition is the whole
# reason this query is fast. The same question written as one pointer block
# followed by a nested UNION took 18.63 s against an 85,810-quad store to
# return these same 1,383 rows; written this way it takes 0.02 s. Measured
# 2026-09-14, in the pod, against the live store.
#
# Why: with the pointer outside, the planner does not push `?run` into the
# arms, so each branch is evaluated across all 21 run graphs and joined
# afterwards. Every branch on its own is already fast -- 0.00 s, 0.02 s, 0.03 s
# when timed separately -- so the cost was never the data. Repeating the
# pointer inside each arm gives the planner a bound `?run` before it touches a
# run graph.
#
# The arms are the two roles crossed with the two kinds, spelled out rather
# than nested, because nesting them is exactly what produced the slow plan. The
# results are identical: both forms were run and their row sets compared.

SELECT ?endpoint ?term ?kind ?declared
WHERE {
  # DECLARED: what the description named, read in the run the pointer names.
  {
    GRAPH sw:current {
      ?ptr sw:sampleRunFor ?endpoint ;
           sw:sampleRunMetric <urn:sparqlwatch:metric:class-profiles> ;
           sw:sampleRunIs ?run .
    }
    GRAPH ?run { ?endpoint sw:declaredClass ?term }
    BIND("class" AS ?kind)
    BIND(true AS ?declared)
  }
  UNION
  {
    GRAPH sw:current {
      ?ptr sw:sampleRunFor ?endpoint ;
           sw:sampleRunMetric <urn:sparqlwatch:metric:class-profiles> ;
           sw:sampleRunIs ?run .
    }
    GRAPH ?run { ?endpoint sw:declaredProperty ?term }
    BIND("property" AS ?kind)
    BIND(true AS ?declared)
  }
  UNION
  # OBSERVED: the classes the profile pass found.
  {
    # THE NEW SHAPE: a profile in its own graph, since 2026-10-03.
    #
    # Written as a SIBLING BRANCH rather than by unioning the graph variable with
    # the old shape's. Both are correct and return the same 55,574 rows, and the
    # difference is 4.8x: measured against the deployed store, unioning `?source`
    # took 7.00s where this takes 1.49s. Binding the graph inside one branch lets
    # the planner push the join; a union of two graph bindings does not.
    GRAPH sw:current { ?endpoint sw:profileGraph ?pg }
    GRAPH ?pg {
      ?profile sw:profiledClass ?term ;
               sw:profiledFrom ?endpoint .
    }
    BIND("class" AS ?kind)
    BIND(false AS ?declared)
  }
  UNION
  {
    # THE OLD SHAPE: a profile inline in its run graph, written before
    # 2026-10-03. The pass rotates every seven days, so an endpoint can wait a
    # week to be rewritten; this branch goes when the last inline profile is
    # pruned. Exactly one branch yields rows per endpoint, because a re-profiled
    # endpoint's newest run holds no inline profiles.
    GRAPH sw:current {
      ?ptr sw:sampleRunFor ?endpoint ;
           sw:sampleRunMetric <urn:sparqlwatch:metric:class-profiles> ;
           sw:sampleRunIs ?run .
    }
    GRAPH ?run {
      ?profile sw:profiledClass ?term ;
               sw:profiledFrom ?endpoint .
    }
    BIND("class" AS ?kind)
    BIND(false AS ?declared)
  }
  UNION
  # OBSERVED: the properties those classes' instances carried.
  {
    # THE NEW SHAPE: a profile in its own graph, since 2026-10-03.
    #
    # Written as a SIBLING BRANCH rather than by unioning the graph variable with
    # the old shape's. Both are correct and return the same 55,574 rows, and the
    # difference is 4.8x: measured against the deployed store, unioning `?source`
    # took 7.00s where this takes 1.49s. Binding the graph inside one branch lets
    # the planner push the join; a union of two graph bindings does not.
    GRAPH sw:current { ?endpoint sw:profileGraph ?pg }
    GRAPH ?pg {
      ?profile sw:profiledFrom ?endpoint ;
               sw:profileProperty ?row .
      ?row sw:property ?term .
    }
    BIND("property" AS ?kind)
    BIND(false AS ?declared)
  }
  UNION
  {
    # THE OLD SHAPE: a profile inline in its run graph, written before
    # 2026-10-03. The pass rotates every seven days, so an endpoint can wait a
    # week to be rewritten; this branch goes when the last inline profile is
    # pruned. Exactly one branch yields rows per endpoint, because a re-profiled
    # endpoint's newest run holds no inline profiles.
    GRAPH sw:current {
      ?ptr sw:sampleRunFor ?endpoint ;
           sw:sampleRunMetric <urn:sparqlwatch:metric:class-profiles> ;
           sw:sampleRunIs ?run .
    }
    GRAPH ?run {
      ?profile sw:profiledFrom ?endpoint ;
               sw:profileProperty ?row .
      ?row sw:property ?term .
    }
    BIND("property" AS ?kind)
    BIND(false AS ?declared)
  }
}
